# Gemini API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Whitelist Phone Numbers & LIDs (comma-separated, format internasional tanpa +)
WHITELIST_PHONE_NUMBERS=6281234567890

# WhatsApp Configuration (Bisa diisi di sini atau di config.yaml)
WA_AUTH_METHOD=qr
WA_PHONE_NUMBER=

# Gateway & Server
GATEWAY_PORT=3001
PYTHON_PORT=8000
PYTHON_WEBHOOK_URL=http://127.0.0.1:8000/api/webhook/whatsapp

# Database URL Override (Opsional, default sqlite di folder data/)
DATABASE_URL=sqlite+aiosqlite:///data/link_curator.db
